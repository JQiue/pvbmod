//--------------------------------------------------------------------------------------------------
// 单位属性升级（护甲 / 护盾 / 能量 / 移速）
//
// 小键盘 5：护盾 ×1.05 再 +7（ShieldsMax / ShieldsStart）
// 小键盘 6：能量上限 +25、初始能量 +25、回复 +0.1/s
// 小键盘 7：护甲 +1（有护盾的单位连 ShieldArmor 一起 +1）
// 小键盘 8：移动速度 ×1.05（速度为 0 的建筑/固定单位跳过）
//
// 只对单位本身的属性生效，不跟进拦截机之类的关联单位；
// 可变形单位仍然会一次升级所有形态（scripts/UnitFamily）。
//--------------------------------------------------------------------------------------------------

include "TriggerLibs/NativeLib"

const string c_statsShieldMultiplier = "1.05";
const string c_statsShieldBonus = "7";
const string c_statsEnergyBonus = "50";
const string c_statsEnergyRegenBonus = "0.1";
const string c_statsSpeedMultiplier = "1.05";

const int c_statsArmor = 0;
const int c_statsShield = 1;
const int c_statsEnergy = 2;
const int c_statsSpeed = 3;

int g_statsUpgradeForms = 0;

void UnitStatsUpgrade_Notify(int player, string inText) {
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaChat,
        StringToText(inText)
    );
}

// 修改一个字段，成功返回 1，失败返回 0（字段不存在时就是失败）。
int UnitStatsUpgrade_ModifyField(
    string unitTypeId, int player, string field, string value, int operation
) {
    if (CatalogFieldValueModify(
        c_gameCatalogUnit, unitTypeId, field, player, value, operation
    )) {
        return 1;
    }

    return 0;
}

fixed UnitStatsUpgrade_ReadFixed(
    string unitTypeId, int player, string field
) {
    return StringToFixed(
        CatalogFieldValueGet(c_gameCatalogUnit, unitTypeId, field, player)
    );
}

// 速度为 0 的单位（建筑、固定炮台）不加速。
bool UnitStatsUpgrade_CanSpeedUp(string unitTypeId, int player) {
    return UnitStatsUpgrade_ReadFixed(unitTypeId, player, "Speed") > 0.0;
}

// 没有护盾/能量的单位不硬塞：否则会被凭空加上 7 点护盾或 25 点能量。
bool UnitStatsUpgrade_HasShield(string unitTypeId, int player) {
    return UnitStatsUpgrade_ReadFixed(unitTypeId, player, "ShieldsMax") > 0.0;
}

bool UnitStatsUpgrade_HasEnergy(string unitTypeId, int player) {
    return UnitStatsUpgrade_ReadFixed(unitTypeId, player, "EnergyMax") > 0.0;
}

int UnitStatsUpgrade_ApplyToType(string unitTypeId, int player, int mode) {
    int applied;

    applied = 0;

    if (mode == c_statsArmor) {
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "LifeArmor", "1", c_upgradeOperationAdd
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "ShieldArmor", "1", c_upgradeOperationAdd
        );

        return applied;
    }

    if (mode == c_statsShield) {
        if (!UnitStatsUpgrade_HasShield(unitTypeId, player)) {
            return 0;
        }

        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "ShieldsMax",
            c_statsShieldMultiplier, c_upgradeOperationMultiply
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "ShieldsMax",
            c_statsShieldBonus, c_upgradeOperationAdd
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "ShieldsStart",
            c_statsShieldMultiplier, c_upgradeOperationMultiply
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "ShieldsStart",
            c_statsShieldBonus, c_upgradeOperationAdd
        );

        return applied;
    }

    if (mode == c_statsEnergy) {
        if (!UnitStatsUpgrade_HasEnergy(unitTypeId, player)) {
            return 0;
        }

        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "EnergyMax",
            c_statsEnergyBonus, c_upgradeOperationAdd
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "EnergyStart",
            c_statsEnergyBonus, c_upgradeOperationAdd
        );
        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "EnergyRegenRate",
            c_statsEnergyRegenBonus, c_upgradeOperationAdd
        );

        return applied;
    }

    if (mode == c_statsSpeed) {
        if (!UnitStatsUpgrade_CanSpeedUp(unitTypeId, player)) {
            return 0;
        }

        applied += UnitStatsUpgrade_ModifyField(
            unitTypeId, player, "Speed",
            c_statsSpeedMultiplier, c_upgradeOperationMultiply
        );
    }

    return applied;
}

// 处理整族形态，返回修改的字段数；形态计数放在 g_statsUpgradeForms。
int UnitStatsUpgrade_Run(string unitTypeId, int player, int mode) {
    int total;
    int i;
    int j;
    int linkedStart;
    int modified;

    UnitFamily_Collect(unitTypeId, player);

    UnitLinks_Reset();

    total = 0;
    g_statsUpgradeForms = 0;

    for (i = 0; i < g_unitFamilyCount; i += 1) {
        linkedStart = g_unitLinkCount;

        UnitLinks_CollectFromAbilities(g_unitFamily[i], player);
        UnitLinks_CollectFromExtraTable(g_unitFamily[i]);

        modified = UnitStatsUpgrade_ApplyToType(g_unitFamily[i], player, mode);

        if (modified > 0) {
            g_statsUpgradeForms += 1;
        }

        total += modified;

        // 只跟进一层关联单位：航母的拦截机、巢虫领主的巢虫等。
        for (j = linkedStart; j < g_unitLinkCount; j += 1) {
            total += UnitStatsUpgrade_ApplyToType(g_unitLinkType[j], player, mode);
        }
    }

    return total;
}

void UnitStatsUpgrade_Report(int player, string unitTypeId, int mode) {
    int modified;
    string title;
    string detail;
    string outText;

    modified = UnitStatsUpgrade_Run(unitTypeId, player, mode);

    if (mode == c_statsArmor) {
        title = "Armor";
        detail = "+1";
    } else if (mode == c_statsShield) {
        title = "Shield";
        detail = "+" + c_statsShieldBonus;
    } else if (mode == c_statsEnergy) {
        title = "Energy";
        detail = "+" + c_statsEnergyBonus;
    } else {
        title = "Speed";
        detail = "+5%";
    }

    if (modified == 0) {
        UnitStatsUpgrade_Notify(
            player, title + ": not applicable to " + unitTypeId
        );
        return;
    }

    outText = title + ": " + unitTypeId + " (" + detail;

    if (g_unitFamilyCount > 1) {
        outText = outText + ", " +
            IntToString(g_statsUpgradeForms) + "/" +
            IntToString(g_unitFamilyCount) + " forms";
    }

    outText = outText + ")";

    UnitStatsUpgrade_Notify(player, outText);
}

int UnitStatsUpgrade_OnKey(bool testConds, bool runActions, int mode) {
    int player;
    string unitTypeId;

    if (!runActions) {
        return 0;
    }

    player = EventPlayer();
    unitTypeId = g_selectedUnitType[player];

    if (unitTypeId == "") {
        UnitStatsUpgrade_Notify(player, "Select a unit first.");
        return 0;
    }

    UnitStatsUpgrade_Report(player, unitTypeId, mode);

    return 0;
}

bool UnitStatsUpgrade_OnArmorHotkey(bool testConds, bool runActions) {
    UnitStatsUpgrade_OnKey(testConds, runActions, c_statsArmor);
    return true;
}

bool UnitStatsUpgrade_OnShieldHotkey(bool testConds, bool runActions) {
    UnitStatsUpgrade_OnKey(testConds, runActions, c_statsShield);
    return true;
}

bool UnitStatsUpgrade_OnEnergyHotkey(bool testConds, bool runActions) {
    UnitStatsUpgrade_OnKey(testConds, runActions, c_statsEnergy);
    return true;
}

bool UnitStatsUpgrade_OnSpeedHotkey(bool testConds, bool runActions) {
    UnitStatsUpgrade_OnKey(testConds, runActions, c_statsSpeed);
    return true;
}

void UnitStatsUpgrade_Init() {
    trigger armorTrigger;
    trigger shieldTrigger;
    trigger energyTrigger;
    trigger speedTrigger;

    armorTrigger = TriggerCreate("UnitStatsUpgrade_OnArmorHotkey");
    TriggerAddEventKeyPressed(
        armorTrigger, c_playerAny, c_keyNumPad7, true, c_keyModifierStateExclude, c_keyModifierStateExclude, c_keyModifierStateExclude
    );

    shieldTrigger = TriggerCreate("UnitStatsUpgrade_OnShieldHotkey");
    TriggerAddEventKeyPressed(
        shieldTrigger, c_playerAny, c_keyNumPad5, true, c_keyModifierStateExclude, c_keyModifierStateExclude, c_keyModifierStateExclude
    );

    energyTrigger = TriggerCreate("UnitStatsUpgrade_OnEnergyHotkey");
    TriggerAddEventKeyPressed(
        energyTrigger, c_playerAny, c_keyNumPad6, true, c_keyModifierStateExclude, c_keyModifierStateExclude, c_keyModifierStateExclude
    );

    speedTrigger = TriggerCreate("UnitStatsUpgrade_OnSpeedHotkey");
    TriggerAddEventKeyPressed(
        speedTrigger, c_playerAny, c_keyNumPad8, true, c_keyModifierStateExclude, c_keyModifierStateExclude, c_keyModifierStateExclude
    );
}
