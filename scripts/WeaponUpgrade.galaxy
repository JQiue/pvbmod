//--------------------------------------------------------------------------------------------------
// 武器升级（攻击频率 / 攻击距离）
//
// 小键盘 2：攻击频率提升（武器 Period ×0.95，最低保留 0.1 秒）
// 小键盘 3：攻击距离提升（武器 Range +1）
//
// 与伤害升级一样，会覆盖：
//   - 单位的所有武器（WeaponArray[i].Link）；
//   - 可变形单位的所有形态（scripts/UnitFamily）；
//   - 关联单位，例如航母的拦截机（scripts/UnitLinks）。
//
// 同一把武器在一次按键里只会被改一次：潜伏者地上/地下的武器是同一个，
// 如果按形态重复处理，一次按键就会变成 ×0.9025 / +2。
//--------------------------------------------------------------------------------------------------

include "TriggerLibs/NativeLib"

const string c_weaponSpeedMultiplier = "0.95";
const string c_weaponRangeBonus = "0.5";

// 攻击间隔的下限，避免连按之后武器每帧开火。
const fixed c_weaponSpeedMinPeriod = 0.1;

const int c_weaponDoneCapacity = 64;

string[64] g_weaponUpgradeDone;
int g_weaponUpgradeDoneCount = 0;

int g_weaponUpgradeForms = 0;
bool g_weaponUpgradeFormTouched = false;

void WeaponUpgrade_Notify(int player, string inText) {
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaChat,
        StringToText(inText)
    );
}

bool WeaponUpgrade_IsDone(string weaponId) {
    int i;

    for (i = 0; i < g_weaponUpgradeDoneCount; i += 1) {
        if (g_weaponUpgradeDone[i] == weaponId) {
            return true;
        }
    }

    return false;
}

void WeaponUpgrade_MarkDone(string weaponId) {
    if (g_weaponUpgradeDoneCount >= c_weaponDoneCapacity) {
        return;
    }

    g_weaponUpgradeDone[g_weaponUpgradeDoneCount] = weaponId;
    g_weaponUpgradeDoneCount += 1;
}

// 攻击间隔已经到下限就不再加速。
bool WeaponUpgrade_CanSpeedUp(string weaponId, int player) {
    fixed period;

    period = StringToFixed(
        CatalogFieldValueGet(
            c_gameCatalogWeapon, weaponId, "Period", player
        )
    );

    if (period <= 0.0) {
        return false;
    }

    return (period * 0.95) >= c_weaponSpeedMinPeriod;
}

int WeaponUpgrade_ModifyWeapon(string weaponId, int player, bool speedMode) {
    if (speedMode) {
        if (!WeaponUpgrade_CanSpeedUp(weaponId, player)) {
            return 0;
        }

        if (CatalogFieldValueModify(
            c_gameCatalogWeapon,
            weaponId,
            "Period",
            player,
            c_weaponSpeedMultiplier,
            c_upgradeOperationMultiply
        )) {
            return 1;
        }

        return 0;
    }

    if (CatalogFieldValueModify(
        c_gameCatalogWeapon,
        weaponId,
        "Range",
        player,
        c_weaponRangeBonus,
        c_upgradeOperationAdd
    )) {
        return 1;
    }

    return 0;
}

// 一个单位类型的所有武器，返回成功修改的数量。
int WeaponUpgrade_ApplyToType(string unitTypeId, int player, bool speedMode) {
    int total;
    int weaponCount;
    int i;
    string weaponId;

    total = 0;

    weaponCount = CatalogFieldValueCount(
        c_gameCatalogUnit, unitTypeId, "WeaponArray", player
    );

    for (i = 0; i < weaponCount; i += 1) {
        weaponId = CatalogFieldValueGet(
            c_gameCatalogUnit,
            unitTypeId,
            "WeaponArray[" + IntToString(i) + "].Link",
            player
        );

        if (weaponId == "") {
            continue;
        }

        if (!CatalogEntryIsValid(c_gameCatalogWeapon, weaponId)) {
            continue;
        }

        if (WeaponUpgrade_IsDone(weaponId)) {
            // 已经在本次按键里处理过（共用武器的形态），算作该形态已覆盖。
            g_weaponUpgradeFormTouched = true;
            continue;
        }

        if (WeaponUpgrade_ModifyWeapon(weaponId, player, speedMode) > 0) {
            WeaponUpgrade_MarkDone(weaponId);
            g_weaponUpgradeFormTouched = true;
            total += 1;
        }
    }

    return total;
}

// 处理整族形态 + 关联单位，返回修改总数；形态计数放在 g_weaponUpgradeForms。
int WeaponUpgrade_Run(string unitTypeId, int player, bool speedMode) {
    int total;
    int i;
    int j;
    int linkedStart;
    int modified;

    UnitFamily_Collect(unitTypeId, player);
    UnitLinks_Reset();

    g_weaponUpgradeDoneCount = 0;

    total = 0;
    g_weaponUpgradeForms = 0;

    for (i = 0; i < g_unitFamilyCount; i += 1) {
        g_weaponUpgradeFormTouched = false;

        linkedStart = g_unitLinkCount;

        UnitLinks_CollectFromAbilities(g_unitFamily[i], player);
        UnitLinks_CollectFromExtraTable(g_unitFamily[i]);

        modified = WeaponUpgrade_ApplyToType(g_unitFamily[i], player, speedMode);

        // 只跟进一层关联单位，避免互相召唤时无限递归。
        for (j = linkedStart; j < g_unitLinkCount; j += 1) {
            modified += WeaponUpgrade_ApplyToType(
                g_unitLinkType[j], player, speedMode
            );
        }

        if (g_weaponUpgradeFormTouched) {
            g_weaponUpgradeForms += 1;
        }

        total += modified;
    }

    return total;
}

void WeaponUpgrade_Report(int player, string unitTypeId, bool speedMode) {
    int modified;
    string outText;

    modified = WeaponUpgrade_Run(unitTypeId, player, speedMode);

    if (modified == 0) {
        if (speedMode) {
            WeaponUpgrade_Notify(
                player, "Attack speed: no weapon found for " + unitTypeId
            );
        } else {
            WeaponUpgrade_Notify(
                player, "Range: no weapon found for " + unitTypeId
            );
        }

        return;
    }

    if (speedMode) {
        outText = "Attack speed: " + unitTypeId +
            " (x" + IntToString(modified) + " weapons";
    } else {
        outText = "Range: " + unitTypeId +
            " (+" + c_weaponRangeBonus +
            " x" + IntToString(modified) + " weapons";
    }

    if (g_unitFamilyCount > 1) {
        outText = outText + ", " +
            IntToString(g_weaponUpgradeForms) + "/" +
            IntToString(g_unitFamilyCount) + " forms";
    }

    outText = outText + ")";

    WeaponUpgrade_Notify(player, outText);
}

bool WeaponUpgrade_OnSpeedHotkey(bool testConds, bool runActions) {
    int player;
    string unitTypeId;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    unitTypeId = g_selectedUnitType[player];

    if (unitTypeId == "") {
        WeaponUpgrade_Notify(player, "Select a unit first.");
        return true;
    }

    WeaponUpgrade_Report(player, unitTypeId, true);

    return true;
}

bool WeaponUpgrade_OnRangeHotkey(bool testConds, bool runActions) {
    int player;
    string unitTypeId;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    unitTypeId = g_selectedUnitType[player];

    if (unitTypeId == "") {
        WeaponUpgrade_Notify(player, "Select a unit first.");
        return true;
    }

    WeaponUpgrade_Report(player, unitTypeId, false);

    return true;
}

void WeaponUpgrade_Init() {
    trigger speedTrigger;
    trigger rangeTrigger;

    speedTrigger = TriggerCreate("WeaponUpgrade_OnSpeedHotkey");
    TriggerAddEventKeyPressed(
        speedTrigger,
        c_playerAny,
        c_keyNumPad2,
        true,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude
    );

    rangeTrigger = TriggerCreate("WeaponUpgrade_OnRangeHotkey");
    TriggerAddEventKeyPressed(
        rangeTrigger,
        c_playerAny,
        c_keyNumPad3,
        true,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude
    );
}
