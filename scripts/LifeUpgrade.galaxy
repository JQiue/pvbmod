//--------------------------------------------------------------------------------------------------
// 生命升级
//
// 按小键盘 4：对当前选中的单位生效。
// 每次升级：最大生命与初始生命 ×1.05 再 +7，每秒生命回复 +0.1。
//
// 可变形单位会一次性升级它的所有形态（见 scripts/UnitFamily）。
// 选择状态由 scripts/Selection 维护。
//--------------------------------------------------------------------------------------------------

include "TriggerLibs/NativeLib"

const string c_lifeUpgradeMultiplier = "1.05";
const string c_lifeUpgradeBonus = "7";
const string c_lifeUpgradeRegenBonus = "0.1";

void LifeUpgrade_Notify(int player, string inText) {
    UIDisplayMessage(
        PlayerGroupSingle(player),
        c_messageAreaChat,
        StringToText(inText)
    );
}

// 修改一个字段，成功返回 1，失败返回 0。
int LifeUpgrade_ModifyField(string unitTypeId, int player, string field, string value, int operation) {
    if (CatalogFieldValueModify(c_gameCatalogUnit, unitTypeId, field, player, value, operation)) {
        return 1;
    }

    return 0;
}

// 对一个单位类型执行升级，返回成功的字段数量。
int LifeUpgrade_ApplyToType(string unitTypeId, int player) {
    int applied;

    applied = 0;

    applied += LifeUpgrade_ModifyField(
        unitTypeId, player, "LifeMax",
        c_lifeUpgradeMultiplier, c_upgradeOperationMultiply
    );
    applied += LifeUpgrade_ModifyField(
        unitTypeId, player, "LifeMax",
        c_lifeUpgradeBonus, c_upgradeOperationAdd
    );
    applied += LifeUpgrade_ModifyField(
        unitTypeId, player, "LifeStart",
        c_lifeUpgradeMultiplier, c_upgradeOperationMultiply
    );
    applied += LifeUpgrade_ModifyField(
        unitTypeId, player, "LifeStart",
        c_lifeUpgradeBonus, c_upgradeOperationAdd
    );
    applied += LifeUpgrade_ModifyField(
        unitTypeId, player, "LifeRegenRate",
        c_lifeUpgradeRegenBonus, c_upgradeOperationAdd
    );

    return applied;
}

bool LifeUpgrade_Apply(bool testConds, bool runActions) {
    int player;
    string unitTypeId;
    int i;
    int j;
    int linkedStart;
    int linkedModified;
    int modifiedForms;
    string outText;

    if (!runActions) {
        return true;
    }

    player = EventPlayer();
    unitTypeId = g_selectedUnitType[player];

    if (unitTypeId == "") {
        LifeUpgrade_Notify(player, "Select a unit first.");
        return true;
    }

    UnitFamily_Collect(unitTypeId, player);

    UnitLinks_Reset();

    modifiedForms = 0;
    linkedModified = 0;

    for (i = 0; i < g_unitFamilyCount; i += 1) {
        linkedStart = g_unitLinkCount;

        UnitLinks_CollectFromAbilities(g_unitFamily[i], player);
        UnitLinks_CollectFromExtraTable(g_unitFamily[i]);

        if (LifeUpgrade_ApplyToType(g_unitFamily[i], player) > 0) {
            modifiedForms += 1;
        }

        // 只跟进一层关联单位：航母的拦截机、巢虫领主的巢虫等。
        for (j = linkedStart; j < g_unitLinkCount; j += 1) {
            if (LifeUpgrade_ApplyToType(g_unitLinkType[j], player) > 0) {
                linkedModified += 1;
            }
        }
    }

    if (modifiedForms == 0) {
        LifeUpgrade_Notify(player, "Life upgrade failed: " + unitTypeId);
        return true;
    }

    outText = "Life upgrade: " + unitTypeId;

    if (g_unitFamilyCount > 1) {
        outText = outText + " (" + IntToString(g_unitFamilyCount) + " forms)";
    }

    if (linkedModified > 0) {
        outText = outText + " +links(" + IntToString(linkedModified) + ")";
    }

    LifeUpgrade_Notify(player, outText);

    return true;
}

void LifeUpgrade_Init() {
    trigger hotkeyTrigger;

    hotkeyTrigger = TriggerCreate("LifeUpgrade_Apply");
    TriggerAddEventKeyPressed(
        hotkeyTrigger,
        c_playerAny,
        c_keyNumPad4,
        true,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude,
        c_keyModifierStateExclude
    );
}
